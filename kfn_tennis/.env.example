# Django
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.ru,www.example.ru
CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru
SITE_URL=https://example.ru

# Security. Set these to True only after HTTPS and proxy headers are configured.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database. Defaults to SQLite when these are not set.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kfn_tennis
# DB_USER=kfn_tennis
# DB_PASSWORD=strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Logging
DJANGO_LOG_LEVEL=INFO
